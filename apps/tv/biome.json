{
  "$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "a11y": {
        "useAltText": "off",
        "useKeyWithClickEvents": "off",
        "useKeyWithMouseEvents": "off",
        "useAriaPropsForRole": "off",
        "useSemanticElements": "off",
        "noAccessKey": "off"
      }
    }
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "!metro.config.js",
      "!babel.config.js",
      "!expo-plugins/**"
    ]
  }
}
