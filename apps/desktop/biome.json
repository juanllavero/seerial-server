{
	"$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
	"root": false,
	"extends": "//",
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"rules": {
			"a11y": {
				"useSemanticElements": "warn",
				"useValidAnchor": "error"
			}
		}
	},
	"files": {
		"includes": [
			"src/**/*.ts",
			"src/**/*.tsx",
			"!src/vite-env.d.ts",
			"!src-tauri"
		]
	}
}
