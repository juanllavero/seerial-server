{
  "name": "@seerial/server",
  "version": "0.2.0",
  "main": "dist/index.js",
  "description": "Media management server for the suite Seerial",
  "author": "Juan Llavero",
  "license": "GPL-3.0-only",
  "private": true,
  "build": {
    "appId": "es.seerial.media",
    "productName": "Seerial Media Server",
    "files": [
      "dist/**",
      "assets/**",
      "node_modules/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffprobe-static",
      "node_modules/ffmpeg-static"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "directories": {
      "output": "prod",
      "buildResources": "assets"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "installerHeaderIcon": "assets/icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Seerial Media Server"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "juanllavero",
        "repo": "seerial-server"
      }
    ],
    "extraMetadata": {
      "description": "Media management server for the suite Seerial"
    }
  },
  "type": "commonjs",
  "scripts": {
    "postinstall": "pnpm run rebuild:electron-native",
    "rebuild:electron-native": "node scripts/rebuild-electron-native.cjs",
    "dev": "node esbuild.config.js && copyfiles -u 1 assets/**/* dist/assets/ && electron dist/index.js",
    "build": "node esbuild.config.js",
    "postbuild": "copyfiles -u 3 ../web/dist/**/* dist/web && copyfiles -u 1 assets/**/* dist/assets/",
    "build-win": "pnpm run build && electron-builder --win",
    "build-mac": "pnpm run build && electron-builder --mac",
    "build-linux": "pnpm run build && electron-builder --linux",
    "publish": "node dist/utils/publish.js",
    "lint": "biome check . && tsc --noEmit",
    "lint:fix": "biome check --write .",
    "tsoa:spec": "tsoa spec",
    "tsoa:routes": "tsoa routes",
    "tsoa:generate": "tsoa spec && tsoa routes",
    "tests": "node scripts/jest-pretty-report.cjs",
    "test:unit": "jest --selectProjects unit --verbose",
    "test:integration": "jest --selectProjects integration --verbose",
    "test:live": "node -e \"process.env.LIVE_INTEGRATION='true'; require('child_process').execSync('jest --selectProjects live --verbose', { stdio: 'inherit', env: process.env })\"",
    "test:coverage": "jest --coverage --verbose"
  },
  "dependencies": {
    "@seerial/domain": "workspace:*",
    "@tsoa/runtime": "7.0.0-alpha.0",
    "@types/bcrypt": "^6.0.0",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "follow-redirects": "^1.15.11",
    "fs-extra": "^11.3.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "moviedb-promise": "^4.0.8",
    "multer": "^2.0.2",
    "nat-upnp": "^1.1.1",
    "ngrok": "5.0.0-beta.2",
    "node-vibrant": "^4.0.4",
    "p-limit": "^7.2.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "properties-reader": "^2.3.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "7.0.0-alpha.0",
    "typeorm": "^0.3.28",
    "typeorm-naming-strategies": "^4.1.0",
    "uuid": "^13.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@seerial/cli": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ffprobe-static": "^2.0.3",
    "@types/follow-redirects": "^1.14.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/nat-upnp": "^1.1.5",
    "@types/properties-reader": "^2.1.3",
    "@types/sql.js": "^1.4.11",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "electron": "^40.1.0",
    "electron-builder": "^26.8.2",
    "electron-icon-builder": "^2.0.1",
    "esbuild": "^0.25.0",
    "jest": "^30.2.0",
    "sql.js": "^1.14.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  }
}
