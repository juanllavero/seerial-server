{
  "$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "a11y": {
        "useSemanticElements": "warn",
        "noSvgWithoutTitle": "warn",
        "useHtmlLang": "error",
        "useValidAnchor": "error"
      }
    }
  },
  "files": {
    "includes": ["src/**/*.ts", "src/**/*.tsx", "!src/vite-env.d.ts"]
  }
}
