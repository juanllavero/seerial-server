{
  "name": "seerial-server",
  "version": "0.2.0",
  "main": "dist/index.js",
  "description": "Media management server for the suite Seerial",
  "author": "Juan Llavero",
  "license": "MIT",
  "private": true,
  "build": {
    "appId": "es.seerial.media",
    "productName": "Seerial Media Server",
    "files": [
      "dist/**",
      "assets/**",
      "node_modules/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "directories": {
      "output": "prod",
      "buildResources": "assets"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "installerHeaderIcon": "assets/icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Seerial Media Server"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "juanllavero",
        "repo": "seerial-server"
      }
    ],
    "extraMetadata": {
      "description": "Media management server for the suite Seerial"
    }
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsc && npm run postbundle",
    "dev": "npm run build && electron dist/index.js",
    "postbundle": "copyfiles -u 1 assets/**/* dist/assets/",
    "build-win": "npm run build && npx electron-builder --win",
    "build-mac": "npm run build && npx electron-builder --mac",
    "build-linux": "npm run build && npx electron-builder --linux",
    "publish": "node dist/utils/publish.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "execa": "^9.6.0",
    "express": "^4.21.2",
    "ffmetadata": "^1.7.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "follow-redirects": "^1.15.9",
    "fs-extra": "^11.3.0",
    "hostile": "^1.4.0",
    "jsonwebtoken": "^9.0.2",
    "moviedb-promise": "^4.0.7",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "node-vibrant": "^4.0.3",
    "open": "^10.1.2",
    "p-limit": "^6.1.0",
    "properties-reader": "^2.3.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "sharp": "^0.34.3",
    "sqlite3": "^5.1.7",
    "sudo-prompt": "^9.2.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/follow-redirects": "^1.14.4",
    "@types/fs-extra": "^11.0.4",
    "@types/get-pixels": "^3.3.4",
    "@types/hostile": "^1.3.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/properties-reader": "^2.1.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "copyfiles": "^2.4.1",
    "dotenv": "^16.5.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "typescript": "^5.4.2"
  }
}
