{
  "name": "seerial",
  "version": "1.0.0",
  "description": "Media management solution",
  "author": "Juan Llavero",
  "license": "GPL-3.0-only",
  "main": "index.js",
  "scripts": {
    "// === RUN APPS INDIVIDUALLY ===": "",
    "dev:server": "turbo dev --filter=@seerial/server",
    "dev:web": "turbo dev --filter=@seerial/web",
    "dev:desktop": "turbo dev --filter=@seerial/desktop",
    "dev:tv": "turbo dev --filter=@seerial/tv",
    "// === RUN WEB AND SERVER ===": "",
    "dev": "turbo dev --filter=@seerial/server --filter=@seerial/web",
    "// === QUALITY ===": "",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "// === BUILD ===": "",
    "build": "turbo build",
    "// === SETUP ===": "",
    "prepare": "lefthook install"
  },
  "keywords": [],
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "lefthook": "^2.1.4",
    "turbo": "^2.8.16",
    "typescript": "^5.9.3"
  }
}
